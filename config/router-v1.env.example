# Experimental router. Source this only into an isolated test process.
RAG_MODEL_ROUTER_MODE=OFF
# Optional trusted marker. Create it to bypass routing on the next request.
RAG_MODEL_ROUTER_OFF_FILE=
RAG_ROUTER_ALLOW_MODEL_CALLS=false
RAG_MODEL_ROUTER_CHEAP_MODEL=Qwen/Qwen3.5-4B
RAG_MODEL_ROUTER_EXPENSIVE_MODEL=zai-org/GLM-5.3-Flash
# Active server-owned CustomModel IDs; do not put credentials here.
RAG_ROUTER_CHEAP_MODEL_ID=
RAG_ROUTER_EXPENSIVE_MODEL_ID=
# Routed Qwen experiment used thinking off; unset preserves provider default.
# Applies only to a routed role, never to the OFF/baseline path.
RAG_ROUTER_CHEAP_ENABLE_THINKING=false
RAG_ROUTER_EXPENSIVE_ENABLE_THINKING=
# Uncalibrated initial settings. 0.35 is a separate experimental candidate.
RAG_MODEL_ROUTER_THRESHOLD=0.5
RAG_MODEL_ROUTER_WEIGHT_T=0.25
RAG_MODEL_ROUTER_WEIGHT_C=0.20
RAG_MODEL_ROUTER_WEIGHT_J=0.25
RAG_MODEL_ROUTER_WEIGHT_D=0.10
RAG_MODEL_ROUTER_WEIGHT_L=0.10
RAG_MODEL_ROUTER_WEIGHT_M=0.10
RAG_MODEL_ROUTER_UNKNOWN_POLICY=BASELINE
RAG_MODEL_ROUTER_ESCALATE_ON_QUALITY_FAIL=true
# No semantic validator; only opt-in REFERENCE_RANGE is implemented.
RAG_ROUTER_QUALITY_CHECK=NONE
# Reserved independent policies: the runtime does not retry these outcomes.
RAG_MODEL_ROUTER_ESCALATE_ON_TRUNCATED=false
RAG_MODEL_ROUTER_ESCALATE_ON_PROVIDER_FALLBACK=false
RAG_MODEL_ROUTER_ESCALATE_ON_UNSUPPORTED=false
# Experimental task interactions; defaults preserve the weighted V1 policy.
# This floor is a preference, NOT a calibrated failure probability.
RAG_MODEL_ROUTER_SELECTION_POLICY=WEIGHTED_V1
RAG_MODEL_ROUTER_TASK_RISK_FLOOR=0.55
