# Copy to runtime-secrets.env. Never commit the filled file.
# Enter only the key after '=' (no surrounding explanations).
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cloud Qwen quality experiments (does not change the product default model).
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional on ECS: export RAG_RUNTIME_SECRETS_FILE=/secure/path/runtime-secrets.env
# Or load this file with your service/container env-file mechanism.
# Do not change the base URL to an untrusted proxy: credentials are sent there.
