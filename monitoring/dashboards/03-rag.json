{
  "uid": "rag-rag",
  "title": "03 SSE and provider",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Scope",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "First answer chunk measures delivery, not necessarily provider token generation; inspect response_delivery. Token counts are provider-reported only. Answer quality, citations and cost remain NOT AVAILABLE without independent evidence."
      }
    },
    {
      "type": "timeseries",
      "title": "SSE terminal outcomes / second",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(rag_sse_requests_total[5m])) by (route, outcome)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NOT AVAILABLE"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
