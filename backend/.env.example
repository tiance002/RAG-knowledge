# 服务配置
HOST=0.0.0.0
PORT=8000
ENV=dev

# 数据库与存储
DATABASE_URL=sqlite:///./local.db
REDIS_URL=redis://localhost:6379/0
# Optional dedicated persistent Redis for explicit user preferences.
# MEMORY_REDIS_URL=redis://127.0.0.1:6381/0
CHROMA_DB_DIR=./storage/chroma_db
# Dedicated worker roles and API share one Chroma service.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
# Chroma read offload: enabled by the ECS API service environment after validation.
# When absent the compatibility path remains synchronous. Start with one read worker.
RAG_CHROMA_EXECUTOR_ENABLED=false
RAG_CHROMA_QUERY_WORKERS=1
RAG_CHROMA_QUERY_HTTP_TIMEOUT_SECONDS=30
# Hybrid initial routes always overlap on the API managed file-SQLite reader.
# FILE_TASK_ARTIFACT_DIR=/srv/rag/storage/task-artifacts
UPLOAD_DIR=./storage/uploads
IMAGE_DIR=./storage/images

# OpenAI-compatible model endpoints. Replace these values locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=
# Non-streamed answer generation only (generate / grounded candidate).
LLM_ANSWER_MAX_TOKENS=4096
# Confirmed no-results response: model (general knowledge) or fixed.
FALLBACK_STRATEGY=model
FALLBACK_PROMPT=请根据通用知识回答用户问题；无法确定时说明不确定。
FALLBACK_RESPONSE=未在所选知识库中找到可用于回答的相关资料。
# Agent relevance grader only (non-streaming, no automatic retry).
AGENT_GRADING_TIMEOUT_SECONDS=60
# Optional Tavily web search (off until enabled for an individual question).
# Keep credentials local. Prefer a UTF-8 file outside the repository.
TAVILY_API_KEY=
TAVILY_API_KEY_FILE=
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=5
# Buffer and validate knowledge-grounded responses before SSE. False keeps extractive output.
RAG_GROUNDED_GENERATION=true
# Optional retrieval-answer routing. OFF preserves the existing model by default.
RAG_MODEL_ROUTER_MODE=OFF
RAG_MODEL_ROUTER_SELECTION_POLICY=WEIGHTED_V1
RAG_MODEL_ROUTER_CHEAP_MODEL=Qwen/Qwen3.5-4B
RAG_MODEL_ROUTER_EXPENSIVE_MODEL=zai-org/GLM-5.3-Flash
# Candidate only: MODE=DYNAMIC, SELECTION_POLICY=RISK_V4, THRESHOLD=0.45.
# Cheap by default; upgrade at >=45 estimated risk points, never probabilities.
# Missing question is UNKNOWN/cheap; failed or empty retrieval remains blocked.
# Direct history arithmetic requires actual assistant history and >=45 points.
# QUALITY_FIRST_V3 remains available for reproduction; defaults stay OFF/WEIGHTED_V1.
# Configure the server-side role records/endpoint credentials as in config/router-v1.env.example.
# Use expensive thinking=false for the compared GLM configuration.
RAG_ROUTER_EXPENSIVE_ENABLE_THINKING=false
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=

# 任务并发控制
MAX_PARSING_WORKERS=2
CELERY_WORKER_CONCURRENCY=2

# 切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# VLM 提示词
VLM_PROMPT=请详细描述这张图片的内容，包括图表中的数据趋势、关键文字信息。

# PDF parsing (local OCR; no new VLM calls)
PDF_PARSER_MODE=legacy
PDF_TESSDATA_DIR=./storage/tessdata
PDF_OCR_DPI=150
PDF_SCANNED_TABLES_ENABLED=false

# Optional PEM CA bundle for verified Embedding / VLM HTTPS endpoints
# PROVIDER_CA_BUNDLE=/path/to/trusted-ca.pem
PDF_TABLES_ENABLED=true
PDF_AUDIT_DIR=./storage/pdf_manifests

# Character budgets (not provider tokens); parent-child splitting is opt-in per parse request.
MAX_PARENT_CONTEXTS=6
CONTEXT_MAX_CHARS=24000
GROUNDED_REQUEST_MAX_CHARS=32000

# Composite rerank ordering; existing threshold still applies to raw rerank_score.
RERANK_MODEL_WEIGHT=0.6
RERANK_RETRIEVAL_WEIGHT=0.3
RERANK_SOURCE_WEIGHT=0.1

# Agent prior KB tool bodies are omitted by default; re-search current sources.
AGENT_RETAIN_RETRIEVAL_HISTORY=false
# Large result files are request-scoped, private, and removed on request exit.
AGENT_TOOL_RESULT_INLINE_CHARS=6000
# Optional private directory; never point at the public static/uploads directory.
# AGENT_TOOL_RESULT_STORE_DIR=
AGENT_TOOL_RESULT_MAX_BYTES=8388608
AGENT_TOOL_RESULT_MAX_ENTRIES=32
