# 服务配置
HOST=0.0.0.0
PORT=8000
ENV=dev

# 数据库与存储
DATABASE_URL=sqlite:///./local.db
REDIS_URL=redis://localhost:6379/0
# Optional dedicated persistent Redis for explicit user preferences.
# MEMORY_REDIS_URL=redis://127.0.0.1:6381/0
CHROMA_DB_DIR=./storage/chroma_db
UPLOAD_DIR=./storage/uploads
IMAGE_DIR=./storage/images

# OpenAI-compatible model endpoints. Replace these values locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=
# Non-streamed answer generation only (generate / grounded candidate).
LLM_ANSWER_MAX_TOKENS=4096
# Confirmed no-results response: model (general knowledge) or fixed.
FALLBACK_STRATEGY=model
FALLBACK_PROMPT=请根据通用知识回答用户问题；无法确定时说明不确定。
FALLBACK_RESPONSE=未在所选知识库中找到可用于回答的相关资料。
# Agent relevance grader only (non-streaming, no automatic retry).
AGENT_GRADING_TIMEOUT_SECONDS=60
# Optional Tavily web search (off until enabled for an individual question).
# Keep credentials local. Prefer a UTF-8 file outside the repository.
TAVILY_API_KEY=
TAVILY_API_KEY_FILE=
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=5
# Buffer and validate knowledge-grounded responses before SSE. False keeps extractive output.
RAG_GROUNDED_GENERATION=true
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=

# 任务并发控制
MAX_PARSING_WORKERS=2

# 切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# VLM 提示词
VLM_PROMPT=请详细描述这张图片的内容，包括图表中的数据趋势、关键文字信息。

# PDF parsing (local OCR; no new VLM calls)
PDF_PARSER_MODE=legacy
PDF_TESSDATA_DIR=./storage/tessdata
PDF_OCR_DPI=150
PDF_SCANNED_TABLES_ENABLED=false

# Optional PEM CA bundle for verified Embedding / VLM HTTPS endpoints
# PROVIDER_CA_BUNDLE=/path/to/trusted-ca.pem
PDF_TABLES_ENABLED=true
PDF_AUDIT_DIR=./storage/pdf_manifests

# Character budgets (not provider tokens); parent-child splitting is opt-in per parse request.
MAX_PARENT_LENGTH=4000
CONTEXT_MAX_CHARS=24000
GROUNDED_REQUEST_MAX_CHARS=32000
